{
  "cleanUrls": true,
  "functions": { "api/ask.js": { "maxDuration": 60 }, "api/agent.js": { "maxDuration": 60 }, "api/speak.js": { "maxDuration": 60 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
